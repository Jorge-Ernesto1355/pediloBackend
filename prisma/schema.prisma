generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean
  image                   String?
  createdAt               DateTime
  updatedAt               DateTime
  acceptLegalDocuments    Boolean                  @default(false)
  ageDeclaration          Boolean                  @default(false)
  legalTermsVersion       String?
  legalPrivacyVersion     String?
  legalAcceptedAt         DateTime?
  sessions                Session[]
  accounts                Account[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  orderModifications      OrderModification[]
  loyaltyStampsCreated    LoyaltyStamp[]           @relation("LoyaltyStampCreatedBy")
  loyaltyStampsVoided     LoyaltyStamp[]           @relation("LoyaltyStampVoidedBy")
  loyaltyRewardsRedeemed  LoyaltyReward[]          @relation("LoyaltyRewardRedeemedBy")

  businessId String?   @unique
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

model Business {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  qrCodeToken     String  @unique @default(cuid())
  description     String?
  logoUrl         String?
  logoBlurUrl     String?
  coverUrl        String?
  coverBlurUrl    String?
  ubication       String?
  scheduleId      String?
  ubicationMapsId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               BusinessMember[]
  settings              BusinessSettings?
  menus                 Menu[]
  categories            Category[]
  products              Product[]
  comboOptionGroups     ComboOptionGroup[]
  comboIncludedProducts ComboIncludedProduct[]
  orders                Order[]
  customers             Customer[]
  customerDiscounts     CustomerDiscount[]
  discounts             Discount[]
  users                 User[]
  images                BusinessImage[]

  businessSchedule   BusinessSchedule?
  ubicationMaps      UbicationMaps?
  googleReviewLink   GoogleReviewLink?
  googleReviewScans  GoogleReviewScan[]
  storeVisits        StoreVisit[]
  paymentCard        RestaurantPaymentCard?
  slugHistory        BusinessSlugHistory[]
  globalOptionGroups GlobalOptionGroup[]
  ingredients        Ingredient[]
  recipeItems        RecipeItem[]
  stockMovements     StockMovement[]
  stockAlerts        StockAlert[]
  inventorySettings  InventorySettings?
  deliveries         Delivery[]
  loyaltyProgram     LoyaltyProgram?
  loyaltyCards       LoyaltyCard[]
  loyaltyStamps      LoyaltyStamp[]
  loyaltyRewards     LoyaltyReward[]
}

model BusinessSlugHistory {
  id         String   @id @default(cuid())
  slug       String   @unique
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model StoreVisit {
  id           String   @id @default(cuid())
  businessId   String
  visitedAt    DateTime @default(now())
  visitorHash  String
  dedupeBucket DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, visitorHash, dedupeBucket], map: "StoreVisit_dedupe_key")
  @@index([businessId, visitedAt])
}

model GoogleReviewLink {
  id         String   @id @default(cuid())
  businessId String   @unique
  qrCode     String   @unique @default(cuid())
  url        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scans    GoogleReviewScan[]
}

model GoogleReviewScan {
  id                 String   @id @default(cuid())
  businessId         String
  googleReviewLinkId String
  visitedAt          DateTime @default(now())
  visitorHash        String
  dedupeBucket       DateTime

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleReviewLink GoogleReviewLink @relation(fields: [googleReviewLinkId], references: [id], onDelete: Cascade)

  @@unique([googleReviewLinkId, visitorHash, dedupeBucket], map: "GoogleReviewScan_dedupe_key")
  @@index([businessId, visitedAt])
  @@index([googleReviewLinkId, visitedAt])
}

enum BusinessImageType {
  LOGO
  COVER
}

model BusinessImage {
  id         String            @id @default(cuid())
  businessId String
  type       BusinessImageType
  url        String
  publicId   String
  blurUrl    String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
}

model UbicationMaps {
  id         String  @id @default(cuid())
  businessId String  @unique
  latitude   Decimal @db.Decimal(10, 7)
  longitude  Decimal @db.Decimal(10, 7)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessSettings {
  id         String @id @default(cuid())
  businessId String @unique

  currency String  @default("MXN")
  phone    String?
  whatsapp String?
  address  String?
  timezone String  @default("America/Mazatlan")

  // Envío a domicilio. El origen del envío es Business.ubicationMaps.
  // deliveryFeeConfig guarda la estructura de tarifa (se define en el dominio de delivery).
  deliveryEnabled   Boolean  @default(false)
  maxDeliveryKm     Decimal? @db.Decimal(5, 2)
  deliveryFeeConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Menu {
  id         String @id @default(cuid())
  businessId String

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories    Category[]
  discountMenus DiscountMenu[]
}

model Category {
  id         String @id @default(cuid())
  businessId String
  menuId     String

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  products           Product[]
  discountCategories DiscountCategory[]
}

enum ProductType {
  PRODUCT
  COMBO
}

model Product {
  id         String @id @default(cuid())
  businessId String
  categoryId String

  name        String
  type        ProductType @default(PRODUCT)
  description String?
  price       Decimal     @db.Decimal(10, 2)

  imageUrl      String?
  imageBlurUrl  String?
  imagePublicId String?
  sortOrder     Int     @default(0)
  isAvailable   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images             ProductImage[]
  optionGroups       ProductOptionGroup[]
  globalOptionGroups ProductGlobalOptionGroup[]
  comboOptionGroups  ComboOptionGroup[]         @relation("ComboParentProduct")
  comboOptions       ComboOptionProduct[]       @relation("ComboChoiceProduct")
  includedInCombos   ComboIncludedProduct[]     @relation("ComboIncludedItem")
  comboIncludes      ComboIncludedProduct[]     @relation("ComboRequiredItems")
  orderItems         OrderItem[]
  discountProducts   DiscountProduct[]
  loyaltyPrograms    LoyaltyProgram[]           @relation("LoyaltyProgramRewardProduct")
  loyaltyRewards     LoyaltyReward[]            @relation("LoyaltyRewardProduct")
  recipeItems        RecipeItem[]

  @@index([businessId, isAvailable, createdAt])
  @@index([businessId, categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOptionGroup {
  id            String   @id @default(cuid())
  productId     String
  name          String
  isRequired    Boolean  @default(false)
  minSelections Int      @default(0) @map("minSelect")
  maxSelections Int      @default(1) @map("maxSelect")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, sortOrder])
}

model ProductOption {
  id            String @id @default(cuid())
  optionGroupId String @map("groupId")

  name          String
  price         Decimal  @default(0) @db.Decimal(10, 2)
  minSelections Int      @default(0) @map("minSelect")
  maxSelections Int      @default(1) @map("maxSelect")
  sortOrder     Int      @default(0)
  isAvailable   Boolean  @default(true) @map("isActive")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  optionGroup ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]

  @@index([optionGroupId, sortOrder])
}

model GlobalOptionGroup {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  isRequired    Boolean   @default(false)
  minSelections Int       @default(0) @map("minSelect")
  maxSelections Int       @default(1) @map("maxSelect")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  options  GlobalOption[]
  products ProductGlobalOptionGroup[]

  @@index([businessId, sortOrder])
}

model GlobalOption {
  id            String   @id @default(cuid())
  groupId       String
  name          String
  price         Decimal  @default(0) @db.Decimal(10, 2)
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  sortOrder     Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group       GlobalOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]

  @@index([groupId, sortOrder])
}

model ProductGlobalOptionGroup {
  productId String
  groupId   String
  sortOrder Int    @default(0)

  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   GlobalOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId, sortOrder])
}

model ComboOptionGroup {
  id             String   @id @default(cuid())
  businessId     String
  comboProductId String
  name           String
  minSelections  Int      @default(1)
  maxSelections  Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  comboProduct Product              @relation("ComboParentProduct", fields: [comboProductId], references: [id], onDelete: Cascade)
  products     ComboOptionProduct[]

  @@index([businessId, comboProductId, sortOrder])
}

model ComboOptionProduct {
  id            String   @id @default(cuid())
  optionGroupId String
  productId     String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  optionGroup ComboOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  product     Product          @relation("ComboChoiceProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([optionGroupId, productId])
  @@index([productId])
  @@index([optionGroupId, sortOrder])
}

model ComboIncludedProduct {
  id             String   @id @default(cuid())
  businessId     String
  comboProductId String
  productId      String
  quantity       Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  comboProduct Product  @relation("ComboRequiredItems", fields: [comboProductId], references: [id], onDelete: Cascade)
  product      Product  @relation("ComboIncludedItem", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([comboProductId, productId])
  @@index([businessId, comboProductId, sortOrder])
  @@index([productId])
}

model Customer {
  id         String @id @default(cuid())
  businessId String

  name       String?
  phone      String
  isDisabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders       Order[]
  discounts    CustomerDiscount[]
  loyaltyCards LoyaltyCard[]

  @@unique([businessId, phone])
}

model Order {
  id         String  @id @default(cuid())
  businessId String
  customerId String?

  orderNumber Int

  status          OrderStatus
  source          OrderSource          @default(PUBLIC)
  fulfillmentType OrderFulfillmentType @default(DINE_IN)
  paymentMethod   OrderPaymentMethod   @default(CASH)
  subtotal        Decimal              @db.Decimal(10, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(10, 2)
  total           Decimal              @db.Decimal(10, 2)
  version         Int                  @default(1)

  customerName   String?
  customerPhone  String?
  idempotencyKey String?

  notes String?

  // Snapshot de entrega a domicilio (solo fulfillmentType = DELIVERY).
  // total sigue siendo la comida con descuentos, SIN envío.
  deliveryAddress      String?   @db.VarChar(200)
  deliveryNeighborhood String?   @db.VarChar(100)
  deliveryReference    String?   @db.VarChar(200)
  deliveryLatitude     Decimal?  @db.Decimal(10, 7)
  deliveryLongitude    Decimal?  @db.Decimal(10, 7)
  deliveryDistanceKm   Decimal?  @db.Decimal(6, 2)
  deliveryFee          Decimal   @default(0) @db.Decimal(10, 2)
  transferConfirmedAt  DateTime?

  // Premio de lealtad canjeado en este pedido (copia histórica: se conserva aunque el
  // pedido se cancele y el premio vuelva a estar disponible) y cuánto descontó.
  // total = subtotal - discountAmount - loyaltyDiscountAmount.
  loyaltyRewardId       String?
  loyaltyDiscountAmount Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  discountsGranted CustomerDiscount[]   @relation("DiscountGrantedFromOrder")
  discountUsed     CustomerDiscount?    @relation("DiscountUsedInOrder")
  modifications    OrderModification[]
  delivery         Delivery?
  loyaltyReward    LoyaltyReward?       @relation("OrderLoyaltyReward", fields: [loyaltyRewardId], references: [id], onDelete: SetNull)
  redeemedReward   LoyaltyReward?       @relation("LoyaltyRewardRedeemedOrder")
  loyaltyStamps    LoyaltyStamp[]

  @@unique([businessId, orderNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, source, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([loyaltyRewardId])
}

model OrderModification {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  version   Int
  changedAt DateTime @default(now())
  changes   Json

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@index([orderId, changedAt])
  @@index([userId, changedAt])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  PUBLIC
  RESTAURANT
}

enum OrderFulfillmentType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum OrderPaymentMethod {
  CASH
  TRANSFER
}

model RestaurantPaymentCard {
  id              String   @id @default(cuid())
  businessId      String   @unique
  clabe           String   @db.VarChar(18)
  beneficiaryName String   @db.VarChar(80)
  bankCode        String   @db.VarChar(3)
  bankName        String   @db.VarChar(80)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("restaurant_payment_cards")
}

// Repartidor independiente. Es GLOBAL: el mismo repartidor sirve a varios restaurantes,
// por eso no tiene businessId. Se identifica por teléfono (10 dígitos de México).
model Courier {
  id        String   @id @default(cuid())
  phone     String   @unique @db.VarChar(10)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  deliveries Delivery[]

  @@map("couriers")
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryFailureReason {
  CUSTOMER_UNREACHABLE
  WRONG_ADDRESS
  CUSTOMER_REJECTED
  OTHER
}

// Entrega de un pedido a domicilio. Los tokens solo se guardan como hash SHA-256 (hex).
// Los montos son snapshots al crear la oferta y no cambian después.
model Delivery {
  id               String         @id @default(cuid())
  businessId       String
  orderId          String         @unique
  courierId        String?
  status           DeliveryStatus @default(PENDING)
  offerTokenHash   String         @unique @db.Char(64)
  offerExpiresAt   DateTime
  courierTokenHash String?        @unique @db.Char(64)

  foodTotal             Decimal            @db.Decimal(10, 2)
  deliveryFee           Decimal            @db.Decimal(10, 2)
  paymentMethod         OrderPaymentMethod
  amountCourierAdvances Decimal            @db.Decimal(10, 2)
  amountCourierCollects Decimal            @db.Decimal(10, 2)

  failureReason DeliveryFailureReason?

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  handedOffAt DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier  Courier? @relation(fields: [courierId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([status])
  @@index([courierId])
  @@map("deliveries")
}

enum CustomerDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CustomerDiscountStatus {
  AVAILABLE
  RESERVED
  USED
  EXPIRED
  CANCELLED
}

model CustomerDiscount {
  id                 String                 @id @default(cuid())
  businessId         String
  customerId         String
  grantedFromOrderId String?
  usedOrderId        String?                @unique
  type               CustomerDiscountType
  value              Decimal                @db.Decimal(10, 2)
  status             CustomerDiscountStatus @default(AVAILABLE)
  expiresAt          DateTime?
  reservedAt         DateTime?
  usedAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  grantedFromOrder Order?   @relation("DiscountGrantedFromOrder", fields: [grantedFromOrderId], references: [id], onDelete: SetNull)
  usedOrder        Order?   @relation("DiscountUsedInOrder", fields: [usedOrderId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId, status])
  @@index([expiresAt])
  @@index([grantedFromOrderId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  subtotal          Decimal @db.Decimal(10, 2)
  unitPriceOriginal Decimal @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal @default(0) @db.Decimal(10, 2)
  unitPriceFinal    Decimal @default(0) @db.Decimal(10, 2)
  discountId        String?
  discountLabel     String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id])
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  options OrderItemOption[]

  @@index([productId])
  @@index([discountId])
}

enum DiscountType {
  PERCENT
  FIXED
}

enum DiscountScope {
  PRODUCTS
  CATEGORIES
  MENU
}

enum DiscountStatus {
  ACTIVE
  FINISHED
  DELETED
}

model Discount {
  id         String             @id @default(cuid())
  businessId String
  name       String             @db.VarChar(60)
  type       DiscountType       @default(PERCENT)
  value      Decimal            @db.Decimal(10, 2)
  scope      DiscountScope
  status     DiscountStatus     @default(ACTIVE)
  startsAt   DateTime           @default(now())
  endsAt     DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   DiscountProduct[]
  categories DiscountCategory[]
  menus      DiscountMenu[]
  orderItems OrderItem[]

  @@index([businessId])
  @@index([businessId, endsAt])
  @@map("discounts")
}

model DiscountMenu {
  discountId String
  menuId     String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([discountId, menuId])
  @@map("discount_menus")
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@map("discount_products")
}

model DiscountCategory {
  discountId String
  categoryId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@map("discount_categories")
}

model OrderItemOption {
  id          String @id @default(cuid())
  orderItemId String

  name      String
  groupName String?
  price     Decimal @db.Decimal(10, 2)

  // Snapshot of the catalog option the customer picked. Plain columns (no FK) so
  // deleting an option never rewrites order history; inventory reads them to
  // find the option's recipe when the order is marked READY.
  productOptionId String?
  globalOptionId  String?

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model BusinessSchedule {
  id         String  @id @default(cuid())
  businessId String  @unique
  days       Json
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum IngredientUnit {
  G
  ML
  UNIT
}

enum LowStockMode {
  PERCENT
  ABSOLUTE
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  WASTE
  ADJUSTMENT
}

enum StockAlertKind {
  STOCK
  CONSUMPTION
}

enum StockAlertLevel {
  LOW
  CRITICAL
  OUT
  HIGH
}

enum StockBlockMode {
  NONE
  OUT_OF_STOCK
  LOW_STOCK
}

model Ingredient {
  id         String @id @default(cuid())
  businessId String

  name String
  unit IngredientUnit

  stock    Decimal @default(0) @db.Decimal(14, 3)
  // Stock considered "full". Percentage thresholds are measured against it.
  parLevel Decimal @default(0) @db.Decimal(14, 3)

  lowStockMode            LowStockMode @default(PERCENT)
  // PERCENT: percentage of parLevel. ABSOLUTE: quantity in `unit`.
  // null falls back to the business default (PERCENT) or 0 (ABSOLUTE).
  lowStockValue           Decimal?     @db.Decimal(14, 3)
  // Per-ingredient override of the business consumption alert percentage.
  consumptionAlertPercent Decimal?     @db.Decimal(5, 2)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  movements   StockMovement[]
  alerts      StockAlert[]

  @@unique([businessId, name])
  @@index([businessId, archivedAt])
}

// One recipe line. Exactly one of productId / productOptionId / globalOptionId
// is set (enforced by a CHECK constraint in the migration).
model RecipeItem {
  id           String  @id @default(cuid())
  businessId   String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3)

  productId       String?
  productOptionId String?
  globalOptionId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredient    Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productOption ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  globalOption  GlobalOption?  @relation(fields: [globalOptionId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@unique([productOptionId, ingredientId])
  @@unique([globalOptionId, ingredientId])
  @@index([businessId])
  @@index([ingredientId])
}

// Append-only ledger. Stock is never edited directly: every change is a row here.
model StockMovement {
  id           String            @id @default(cuid())
  businessId   String
  ingredientId String
  type         StockMovementType
  // Signed change applied to the stock (negative for consumption and waste).
  quantity     Decimal           @db.Decimal(14, 3)
  stockAfter   Decimal           @db.Decimal(14, 3)
  orderId      String?
  userId       String?
  note         String?
  createdAt    DateTime          @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  // A given order can consume a given ingredient only once.
  @@unique([orderId, ingredientId, type])
  @@index([ingredientId, createdAt])
  @@index([businessId, createdAt])
}

model StockAlert {
  id           String          @id @default(cuid())
  businessId   String
  ingredientId String
  kind         StockAlertKind
  level        StockAlertLevel
  stock        Decimal         @db.Decimal(14, 3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  // Set automatically once the condition clears (restock or lower usage).
  resolvedAt   DateTime?

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([businessId, resolvedAt])
  @@index([ingredientId, kind, resolvedAt])
}

model InventorySettings {
  id         String @id @default(cuid())
  businessId String @unique

  alertsEnabled           Boolean        @default(true)
  defaultLowStockPercent  Decimal        @default(20) @db.Decimal(5, 2)
  consumptionAlertPercent Decimal        @default(20) @db.Decimal(5, 2)
  consumptionWindowHours  Int            @default(24)
  // Applied to public (customer) orders only; staff can still register orders.
  blockMode               StockBlockMode @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Tarjeta de lealtad por sellos ────────────────────────────────────────────
// Reversión: prisma/migrations/20261122200000_add_loyalty_program/down.sql.
// Índices y restricciones que Prisma no sabe expresar (viven solo en la migración):
//   - loyalty_stamps_active_order_key: UNIQUE parcial ("orderId") WHERE "orderId" IS NOT NULL
//     AND "voidedAt" IS NULL → un pedido sella una sola vez.
//   - CHECKs de rangos (sellos 3–20, conteos >= 0, montos >= 0, porcentaje <= 100, etc.).

enum LoyaltyStampMode {
  MANUAL
  AUTO
}

enum LoyaltyRewardType {
  PERCENT
  FIXED
  FREE_PRODUCT
}

enum LoyaltyStampSource {
  ORDER_MANUAL
  ORDER_AUTO
  WALK_IN
}

enum LoyaltyRewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
  VOID
}

// Un programa por restaurante. `design` es JSON con lista cerrada de valores (versión
// `designVersion`), validado en el dominio; nunca CSS libre.
model LoyaltyProgram {
  id                String            @id @default(cuid())
  businessId        String            @unique
  enabled           Boolean           @default(true)
  stampsRequired    Int               @default(8)
  stampMode         LoyaltyStampMode  @default(MANUAL)
  minOrderAmount    Decimal           @default(0) @db.Decimal(10, 2)
  rewardType        LoyaltyRewardType @default(PERCENT)
  rewardValue       Decimal           @default(20) @db.Decimal(10, 2)
  rewardProductId   String?
  rewardLabel       String            @db.VarChar(40)
  rewardExpiresDays Int?
  /// Tope antiabuso de sellos en el local (walk_in) por cliente y por día.
  walkInDailyLimit  Int               @default(5)
  design            Json
  designVersion     Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rewardProduct Product? @relation("LoyaltyProgramRewardProduct", fields: [rewardProductId], references: [id], onDelete: SetNull)

  @@index([rewardProductId])
  @@map("loyalty_programs")
}

// Tarjeta de un cliente en un restaurante. Se crea de forma perezosa.
// `publicToken` es la llave del link privado del cliente (32 bytes aleatorios, base64url).
// `stampsCount` es derivado (avance del ciclo actual): solo cambia en la misma transacción
// que inserta o anula un sello, con la fila bloqueada (SELECT ... FOR UPDATE).
model LoyaltyCard {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String
  publicToken     String   @unique @db.VarChar(64)
  stampsCount     Int      @default(0)
  cyclesCompleted Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stamps   LoyaltyStamp[]
  rewards  LoyaltyReward[]

  @@unique([businessId, customerId])
  @@index([customerId])
  @@index([businessId, stampsCount])
  @@map("loyalty_cards")
}

// Un sello nunca se borra: se anula (voidedAt + voidedReason + voidedByUserId).
// `cycle` = ciclo de la tarjeta al sellar (cyclesCompleted en ese momento);
// `position` = número de sello dentro de ese ciclo (1..stampsRequired).
model LoyaltyStamp {
  id              String             @id @default(cuid())
  cardId          String
  businessId      String
  orderId         String?
  source          LoyaltyStampSource
  note            String?            @db.VarChar(140)
  createdByUserId String?
  cycle           Int
  position        Int
  createdAt       DateTime           @default(now())
  voidedAt        DateTime?
  voidedReason    String?            @db.VarChar(140)
  voidedByUserId  String?

  card      LoyaltyCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("LoyaltyStampCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voidedBy  User?          @relation("LoyaltyStampVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  reward    LoyaltyReward? @relation("LoyaltyRewardSourceStamp")

  @@index([cardId, createdAt])
  @@index([businessId, createdAt])
  @@index([orderId])
  @@map("loyalty_stamps")
}

// Premio ganado al completar la tarjeta. Guarda una COPIA del premio del programa al
// generarse: cambiar el programa después no altera premios ya ganados.
// AVAILABLE con expiresAt vencido se trata como EXPIRED al leerlo (sin procesos aparte).
model LoyaltyReward {
  id                String              @id @default(cuid())
  cardId            String
  businessId        String
  status            LoyaltyRewardStatus @default(AVAILABLE)
  rewardType        LoyaltyRewardType
  rewardValue       Decimal             @db.Decimal(10, 2)
  rewardProductId   String?
  rewardProductName String?             @db.VarChar(120)
  rewardLabel       String              @db.VarChar(40)
  cycle             Int
  sourceStampId     String?             @unique
  expiresAt         DateTime?
  redeemedAt        DateTime?
  redeemedOrderId   String?             @unique
  redeemedByUserId  String?
  voidedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  card          LoyaltyCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rewardProduct Product?      @relation("LoyaltyRewardProduct", fields: [rewardProductId], references: [id], onDelete: SetNull)
  sourceStamp   LoyaltyStamp? @relation("LoyaltyRewardSourceStamp", fields: [sourceStampId], references: [id], onDelete: SetNull)
  redeemedOrder Order?        @relation("LoyaltyRewardRedeemedOrder", fields: [redeemedOrderId], references: [id], onDelete: SetNull)
  redeemedBy    User?         @relation("LoyaltyRewardRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  ordersApplied Order[]       @relation("OrderLoyaltyReward")

  @@index([cardId, status])
  @@index([businessId, status])
  @@index([rewardProductId])
  @@map("loyalty_rewards")
}
