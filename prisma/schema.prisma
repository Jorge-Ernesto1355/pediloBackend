generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean
  image                   String?
  createdAt               DateTime
  updatedAt               DateTime
  acceptLegalDocuments    Boolean                  @default(false)
  ageDeclaration          Boolean                  @default(false)
  legalTermsVersion       String?
  legalPrivacyVersion     String?
  legalAcceptedAt         DateTime?
  sessions                Session[]
  accounts                Account[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  businessId String?   @unique
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

model Business {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String?
  logoUrl         String?
  logoBlurUrl     String?
  coverUrl        String?
  coverBlurUrl    String?
  ubication       String?
  scheduleId      String?
  ubicationMapsId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               BusinessMember[]
  settings              BusinessSettings?
  menus                 Menu[]
  categories            Category[]
  products              Product[]
  comboOptionGroups     ComboOptionGroup[]
  comboIncludedProducts ComboIncludedProduct[]
  orders                Order[]
  customers             Customer[]
  customerDiscounts     CustomerDiscount[]
  users                 User[]
  images                BusinessImage[]

  businessSchedule  BusinessSchedule?
  ubicationMaps     UbicationMaps?
  googleReviewLink  GoogleReviewLink?
  googleReviewScans GoogleReviewScan[]
  storeVisits       StoreVisit[]
}

model StoreVisit {
  id           String   @id @default(cuid())
  businessId   String
  visitedAt    DateTime @default(now())
  visitorHash  String
  dedupeBucket DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, visitorHash, dedupeBucket], map: "StoreVisit_dedupe_key")
  @@index([businessId, visitedAt])
}

model GoogleReviewLink {
  id         String   @id @default(cuid())
  businessId String   @unique
  qrCode     String   @unique @default(cuid())
  url        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scans    GoogleReviewScan[]
}

model GoogleReviewScan {
  id                 String   @id @default(cuid())
  businessId         String
  googleReviewLinkId String
  visitedAt          DateTime @default(now())
  visitorHash        String
  dedupeBucket       DateTime

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleReviewLink GoogleReviewLink @relation(fields: [googleReviewLinkId], references: [id], onDelete: Cascade)

  @@unique([googleReviewLinkId, visitorHash, dedupeBucket], map: "GoogleReviewScan_dedupe_key")
  @@index([businessId, visitedAt])
  @@index([googleReviewLinkId, visitedAt])
}

enum BusinessImageType {
  LOGO
  COVER
}

model BusinessImage {
  id         String            @id @default(cuid())
  businessId String
  type       BusinessImageType
  url        String
  publicId   String
  blurUrl    String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
}

model UbicationMaps {
  id         String  @id @default(cuid())
  businessId String  @unique
  latitude   Decimal @db.Decimal(10, 7)
  longitude  Decimal @db.Decimal(10, 7)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessSettings {
  id         String @id @default(cuid())
  businessId String @unique

  currency String  @default("MXN")
  phone    String?
  whatsapp String?
  address  String?
  timezone String  @default("America/Mazatlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Menu {
  id         String @id @default(cuid())
  businessId String

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories Category[]
}

model Category {
  id         String @id @default(cuid())
  businessId String
  menuId     String

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  products Product[]
}

enum ProductType {
  PRODUCT
  COMBO
}

model Product {
  id         String @id @default(cuid())
  businessId String
  categoryId String

  name        String
  type        ProductType @default(PRODUCT)
  description String?
  price       Decimal     @db.Decimal(10, 2)

  imageUrl      String?
  imageBlurUrl  String?
  imagePublicId String?
  sortOrder     Int     @default(0)
  isAvailable   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images            ProductImage[]
  optionGroups      ProductOptionGroup[]
  comboOptionGroups ComboOptionGroup[]     @relation("ComboParentProduct")
  comboOptions      ComboOptionProduct[]   @relation("ComboChoiceProduct")
  includedInCombos  ComboIncludedProduct[] @relation("ComboIncludedItem")
  comboIncludes     ComboIncludedProduct[] @relation("ComboRequiredItems")
  orderItems        OrderItem[]

  @@index([businessId, isAvailable, createdAt])
  @@index([businessId, categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOptionGroup {
  id            String   @id @default(cuid())
  productId     String
  name          String
  isRequired    Boolean  @default(false)
  minSelections Int      @default(0) @map("minSelect")
  maxSelections Int      @default(1) @map("maxSelect")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, sortOrder])
}

model ProductOption {
  id            String @id @default(cuid())
  optionGroupId String @map("groupId")

  name          String
  price         Decimal  @default(0) @db.Decimal(10, 2)
  minSelections Int      @default(0) @map("minSelect")
  maxSelections Int      @default(1) @map("maxSelect")
  sortOrder     Int      @default(0)
  isAvailable   Boolean  @default(true) @map("isActive")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  optionGroup ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId, sortOrder])
}

model ComboOptionGroup {
  id             String   @id @default(cuid())
  businessId     String
  comboProductId String
  name           String
  minSelections  Int      @default(1)
  maxSelections  Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  comboProduct Product              @relation("ComboParentProduct", fields: [comboProductId], references: [id], onDelete: Cascade)
  products     ComboOptionProduct[]

  @@index([businessId, comboProductId, sortOrder])
}

model ComboOptionProduct {
  id            String   @id @default(cuid())
  optionGroupId String
  productId     String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  optionGroup ComboOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  product     Product          @relation("ComboChoiceProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([optionGroupId, productId])
  @@index([productId])
  @@index([optionGroupId, sortOrder])
}

model ComboIncludedProduct {
  id             String   @id @default(cuid())
  businessId     String
  comboProductId String
  productId      String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  comboProduct Product  @relation("ComboRequiredItems", fields: [comboProductId], references: [id], onDelete: Cascade)
  product      Product  @relation("ComboIncludedItem", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([comboProductId, productId])
  @@index([businessId, comboProductId, sortOrder])
  @@index([productId])
}

model Customer {
  id         String @id @default(cuid())
  businessId String

  name  String?
  phone String
  isDisabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders    Order[]
  discounts CustomerDiscount[]

  @@unique([businessId, phone])
}

model Order {
  id         String  @id @default(cuid())
  businessId String
  customerId String?

  orderNumber Int

  status          OrderStatus
  source          OrderSource          @default(PUBLIC)
  fulfillmentType OrderFulfillmentType @default(DINE_IN)
  subtotal        Decimal              @db.Decimal(10, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(10, 2)
  total           Decimal              @db.Decimal(10, 2)

  customerName  String?
  customerPhone String?
  idempotencyKey String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  discountsGranted CustomerDiscount[]   @relation("DiscountGrantedFromOrder")
  discountUsed     CustomerDiscount?    @relation("DiscountUsedInOrder")

  @@unique([businessId, orderNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, source, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum OrderSource {
  PUBLIC
  RESTAURANT
}

enum OrderFulfillmentType {
  DINE_IN
  PICKUP
}

enum CustomerDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CustomerDiscountStatus {
  AVAILABLE
  RESERVED
  USED
  EXPIRED
  CANCELLED
}

model CustomerDiscount {
  id                 String                 @id @default(cuid())
  businessId         String
  customerId         String
  grantedFromOrderId String?
  usedOrderId        String?                @unique
  type               CustomerDiscountType
  value              Decimal                @db.Decimal(10, 2)
  status             CustomerDiscountStatus @default(AVAILABLE)
  expiresAt          DateTime?
  reservedAt         DateTime?
  usedAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  grantedFromOrder Order?   @relation("DiscountGrantedFromOrder", fields: [grantedFromOrderId], references: [id], onDelete: SetNull)
  usedOrder        Order?   @relation("DiscountUsedInOrder", fields: [usedOrderId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId, status])
  @@index([expiresAt])
  @@index([grantedFromOrderId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  subtotal Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  options OrderItemOption[]

  @@index([productId])
}

model OrderItemOption {
  id          String @id @default(cuid())
  orderItemId String

  name      String
  groupName String?
  price     Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model BusinessSchedule {
  id         String  @id @default(cuid())
  businessId String  @unique
  days       Json
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
